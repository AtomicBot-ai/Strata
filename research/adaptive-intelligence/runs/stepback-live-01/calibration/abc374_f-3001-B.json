  "selected": {
    "code": "import sys\nfrom functools import lru_cache\n\ndef main():\n    data = sys.stdin.read().split()\n    n, k, x = int(data[0]), int(data[1]), int(data[2])\n    T = list(map(int, data[3:3+n]))\n    INF = 10**18\n\n    @lru_cache(None)\n    def dp(i, day):\n        if i >= n:\n            return 0\n        best = INF\n        # group size 1..K\n        for size in range(1, min(k, n-i)+1):\n            # ship orders i..i+size-1 on some day >= T_{i+size-1}\n            # and >= day\n            max_T = T[i+size-1]\n            # choose day; dissatisfaction = size*day - sum T[i..i+size-1]\n            # but day must be >= max(day, max_T). choose earliest optimal day.\n            # Since coefficient size positive, the minimal day is day0 = max(day, max_T)\n            # however could consider later day to allow? Later day only increases dissatisfaction, so earliest is best.\n            day0 = max(day, max_T)\n            s = 0\n            for j in range(i, i+size):\n                s += T[j]\n            cost = size*day0 - s\n            nxt = day0 + x\n            best = min(best, cost + dp(i+size, nxt))\n        return best\n\n    print(dp(0, 0))\n\nif __name__ == \"__main__\":\n    main()",
