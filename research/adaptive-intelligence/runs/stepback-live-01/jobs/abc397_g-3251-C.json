  "selected": {
    "code": "import sys\nfrom itertools import combinations\n\ndef dijkstra(N, adj, src):\n    dist = [float('inf')] * (N + 1)\n    dist[src] = 0\n    # small graph: simple O(N^2) Dijkstra\n    for _ in range(N):\n        u = -1\n        best = float('inf')\n        for i in range(1, N + 1):\n            if dist[i] < best:\n                best = dist[i]\n                u = i\n        if u == -1 or best == float('inf'):\n            break\n        for v, w in adj[u]:\n            nd = dist[u] + w\n            if nd < dist[v]:\n                dist[v] = nd\n    return dist[N]\n\ndef main():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    it = iter(data)\n    N = int(next(it)); M = int(next(it)); K = int(next(it))\n    edges = []\n    for _ in range(M):\n        u = int(next(it)); v = int(next(it))\n        edges.append((u, v))\n    best = -1\n    for idxs in combinations(range(M), K):\n        selected = set(idxs)\n        adj = [[] for _ in range(N + 1)]\n        for j, (u, v) in enumerate(edges):\n            w = 1 if j in selected else 0\n            adj[u].append((v, w))\n        d = dijkstra(N, adj, 1)\n        if d > best:\n            best = d\n    print(best)\n\nif __name__ == \"__main__\":\n    main()",
