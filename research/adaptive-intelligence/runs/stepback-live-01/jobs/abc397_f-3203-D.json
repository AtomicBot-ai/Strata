    "code": "import sys\n\ndef main():\n    data = list(map(int, sys.stdin.read().split()))\n    n = data[0]\n    a = data[1:]\n    prefix = [0] * (n + 1)\n    seen = set()\n    for k in range(1, n + 1):\n        seen.add(a[k - 1])\n        prefix[k] = len(seen)\n    suffix = [0] * (n + 1)\n    seen = set()\n    for k in range(n, 0, -1):\n        seen.add(a[k - 1])\n        suffix[k] = len(seen)  # suffix[k] distinct in [k..n] (1-indexed)\n    ans = 0\n    for i in range(1, n):\n        # segment 1: 1..i\n        left = prefix[i]\n        # iterate j from i+1 to n-1\n        mid_seen = set()\n        for j in range(i + 1, n):\n            mid_seen.add(a[j - 1])\n            mid = len(mid_seen)\n            right = suffix[j + 1] if j + 1 <= n else 0\n            # suffix[j+1] is distinct in [j+1..n]; if j+1 == n+1, no segment -> 0\n            total = left + mid + right\n            if total > ans:\n                ans = total\n    print(ans)\n\nmain()",
