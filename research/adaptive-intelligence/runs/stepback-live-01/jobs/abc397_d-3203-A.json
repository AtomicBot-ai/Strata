    "code": "import math\nimport sys\n\ndef solve():\n    data = sys.stdin.read().strip()\n    if not data:\n        return\n    N = int(data)\n    # iterate divisors d of N\n    divisors = []\n    limit = int(math.isqrt(N))\n    for d in range(1, limit + 1):\n        if N % d == 0:\n            divisors.append(d)\n            if d != N // d:\n                divisors.append(N // d)\n    # unique\n    divisors = sorted(set(divisors))\n    # limit d cannot exceed N (small enough), but we can filter d <= cbrt(N)+1 maybe\n    # cbrt bound\n    bound = int(round(N ** (1/3))) + 2\n    for d in divisors:\n        if d > bound:\n            continue\n        q = N // d\n        # q = 3y^2 + 3 d y + d^2\n        # 3y^2 + 3d y + (d^2 - q) = 0\n        # quadratic in y: a=3, b=3d, c=d^2 - q\n        a = 3\n        b = 3 * d\n        c = d * d - q\n        discriminant = b * b - 4 * a * c\n        if discriminant < 0:\n            continue\n        disc = int(round(math.isqrt(discriminant)))\n        # check exact square\n        if disc * disc != discriminant:\n            continue\n        # y = (-b + sqrt(disc)) / (2a)\n        y_num = -b + disc\n        if y_num % (2 * a) != 0:\n            continue\n        y = y_num // (2 * a)\n        if y <= 0:\n            continue\n        x = y + d\n        if x * x * x - y * y * y == N:\n            print(x, y)\n            return\n    print(-1)\n\nsolve()",
