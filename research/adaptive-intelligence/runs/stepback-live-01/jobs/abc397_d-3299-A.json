    "code": "import sys\nimport math\n\ndef solve():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    N = int(data[0])\n\n    def divisors(n):\n        divs = []\n        i = 1\n        while i * i <= n:\n            if n % i == 0:\n                divs.append(i)\n                if i * i != n:\n                    divs.append(n // i)\n            i += 1\n        return divs\n\n    for d in divisors(N):\n        q = N // d\n        disc = 12 * q - 3 * d * d\n        if disc < 0:\n            continue\n        s = math.isqrt(disc)\n        if s * s != disc:\n            continue\n        # y = (-3d + s) / 6, x = y + d\n        num = s - 3 * d\n        if num % 6 != 0:\n            continue\n        y = num // 6\n        x = y + d\n        if x > 0 and y > 0 and x * x * x - y * y * y == N:\n            print(x, y)\n            return\n\n    print(-1)\n\nsolve()",
