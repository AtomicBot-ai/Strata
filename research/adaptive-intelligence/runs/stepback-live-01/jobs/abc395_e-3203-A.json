    "code": "import sys\nimport heapq\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    idx = 0\n    N = int(data[idx]); M = int(data[idx+1]); X = int(data[idx+2]); idx += 3\n    edges = []\n    for _ in range(M):\n        u = int(data[idx]); v = int(data[idx+1]); idx += 2\n        edges.append((u, v))\n\n    def run():\n        INF = float('inf')\n        dist = [[INF]*2 for _ in range(N+1)]\n        pq = []\n        dist[1][0] = 0\n        heapq.heappush(pq, (0, 1, 0))\n        while pq:\n            d, v, ori = heapq.heappop(pq)\n            if d != dist[v][ori]:\n                continue\n            # Moves\n            for i in range(M):\n                u, w = edges[i]\n                nxt = w if ori == 0 else u\n                src = v if ori == 0 else w\n                # better check: current vertex in orientation ori\n                # In ori=0 edge u->w; in ori=1 edge w->u\n                # From current v, outgoing neighbor is:\n                # ori=0: v->w if edge v->w\n                # ori=1: v->u if edge u->w (after reversal edge w->u)\n                # compute per edge explicitly\n                # (done below)\n            # Simpler loop per edge\n            # Move along edge:\n            for u, w in edges:\n                if ori == 0:\n                    if v == u:\n                        nxt = w\n                    else:\n                        continue\n                else:\n                    if v == w:\n                        nxt = u\n                    else:\n                        continue\n                nd = d + 1\n                if nd < dist[nxt][ori]:\n                    dist[nxt][ori] = nd\n                    heapq.heappush(pq, (nd, nxt, ori))\n            # Reversal\n            nd = d + X\n            ori2 = 1 - ori\n            if nd < dist[v][ori2]:\n                dist[v][ori2] = nd\n                heapq.heappush(pq, (nd, v, ori2))\n        return min(dist[N][0], dist[N][1])\n\n    print(run())\n\nif __name__ == '__main__':\n    main()",
