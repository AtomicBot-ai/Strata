    "code": "import sys\n\ndef main():\n    data = sys.stdin.read().split()\n    idx = 0\n    N = int(data[idx]); idx += 1\n    M = int(data[idx]); idx += 1\n    edges = []\n    for _ in range(M):\n        u = int(data[idx]); v = int(data[idx+1]); w = int(data[idx+2]); idx += 3\n        edges.append((u, v, w))\n    adj = [[] for _ in range(N+1)]\n    for u, v, w in edges:\n        adj[u].append((v, w))\n        adj[v].append((u, w))\n\n    best = None\n    visited = 0  # bit for vertex 1\n\n    def dfs(u, mask, xor):\n        nonlocal best\n        if u == N:\n            if best is None or xor < best:\n                best = xor\n            return\n        for v, w in adj[u]:\n            bit = 1 << v\n            if not (mask & bit):\n                dfs(v, mask | bit, xor ^ w)\n\n    dfs(1, 1 << 1, 0)\n    print(best)\n\nmain()",
