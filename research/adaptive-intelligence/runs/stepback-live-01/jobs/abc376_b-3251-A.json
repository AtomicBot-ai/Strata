    "code": "import sys\nfrom collections import deque\n\ndef solve():\n    data = sys.stdin.read().split()\n    idx = 0\n    N = int(data[idx]); idx += 1\n    Q = int(data[idx]); idx += 1\n\n    l = 1\n    r = 2\n    total = 0\n\n    def neighbors(x):\n        # ring neighbors 1..N\n        a = x - 1 if x > 1 else N\n        b = x + 1 if x < N else 1\n        return (a, b)\n\n    for _ in range(Q):\n        H = data[idx]; T = int(data[idx+1]); idx += 2\n        if H == 'L':\n            start = l\n            fixed = r\n            forbidden = fixed\n        else:\n            start = r\n            fixed = l\n            forbidden = fixed\n\n        # movable hand must reach T; T != fixed is guaranteed\n        if start == T:\n            dist = 0\n        else:\n            q = deque([start])\n            dist_map = {start: 0}\n            target = None\n            while q:\n                x = q.popleft()\n                if x == T:\n                    target = dist_map[x]\n                    break\n                for y in neighbors(x):\n                    if y == forbidden:\n                        continue\n                    if y not in dist_map:\n                        dist_map[y] = dist_map[x] + 1\n                        q.append(y)\n            target = dist_map.get(T, 0)\n            dist = target\n\n        total += dist\n        if H == 'L':\n            l = T\n        else:\n            r = T\n\n    print(total)\n\nsolve()",
