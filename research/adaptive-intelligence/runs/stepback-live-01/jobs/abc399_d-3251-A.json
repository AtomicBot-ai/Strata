  "selected": {
    "code": "import sys\n\ndef solve():\n    input = sys.stdin.readline\n    T = int(input())\n    out = []\n    for _ in range(T):\n        N = int(input())\n        A = list(map(int, input().split()))\n        pos = [[] for _ in range(N + 1)]\n        for i, v in enumerate(A):\n            pos[v].append(i)\n        ans = 0\n        # For each pair of values, check the four positions\n        # Simplified reachability: two a positions and two b positions must be\n        # able to form adjacent blocks after swaps.\n        for a in range(1, N + 1):\n            p1, p2 = pos[a]\n            if abs(p1 - p2) == 1:\n                continue\n            for b in range(a + 1, N + 1):\n                q1, q2 = pos[b]\n                if abs(q1 - q2) == 1:\n                    continue\n                # The four positions must be rearranged into two adjacent blocks.\n                # A swap between an a-position and b-position exchanges the values\n                # at those positions, so we just check all ways to assign which\n                # of the four positions become the a-block and b-block.\n                # Reachability condition used here: the positions must not have a\n                # gap that blocks both values from becoming adjacent in the same\n                # 4-position window; equivalently the two pairs must be able to\n                # be placed in two adjacent length-2 segments.\n                positions = [p1, p2, q1, q2]\n                ok = False\n                # all choices of which two positions hold a (remaining hold b)\n                # must be reachable; test the four possible block layouts\n                # Easier sufficient test: compute minimum span needed for two blocks.\n                # We only accept a pair if the four positions are arranged so\n                # both pairs can be made adjacent (a,a) and (b,b) without\n                # overlap. This is checked by verifying both blocks fit in the\n                # same 4-position pattern.\n                # A concrete enumeration of the possible target layouts of four\n                # positions as two length-2 adjacent runs.\n                # We enumerate all choices for the a-block positions.\n                idxs = [0, 1, 2, 3]\n                for i in range(4):\n                    for j in range(i + 1, 4):\n                        # choose two positions to be a-block (must be adjacent)\n                        if abs(positions[i] - positions[j]) != 1:\n                            continue\n                        a_set = {positions[i], positions[j]}\n                        b_set = {p for p in positions if p not in a_set}\n                        if len(b_set) == 2:\n                            vals = list(b_set)\n                            if abs(vals[0] - vals[1]) == 1:\n                                ok = True\n                                break\n                    if ok:\n                        break\n                if ok:\n                    ans += 1\n        out.append(str(ans))\n    sys.stdout.write(\"\\n\".join(out))\n\nsolve()",
