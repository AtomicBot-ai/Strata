    "code": "import sys\n\ndef dist_dir(a, b, N, step):\n    # distance along direction step (+1 or -1) from a to b on ring\n    d = (b - a) % N\n    if step == -1:\n        d = (a - b) % N\n    return d\n\ndef move_cost(start, target, fixed, N):\n    if start == target:\n        return 0\n    # directions: +1 (increasing labels), -1 (decreasing labels)\n    for step in (1, -1):\n        # path positions visited (excluding start, including target)\n        d = dist_dir(start, target, N, step)\n        pos = start\n        blocked = False\n        # check if fixed hand is on path (including target? target != fixed by guarantee)\n        for _ in range(d):\n            pos = (pos + step) % N\n            if pos == (fixed - 1) % N:  # fixed position is in 0..N-1, convert\n                blocked = True\n                break\n            # careful: fixed is in 1..N, but pos is in 0..N-1; fix below\n        # Simpler check: simulate with 1..N\n        pos = start\n        blocked = False\n        for _ in range(d):\n            pos = pos + step\n            if pos == 0:\n                pos = N\n            elif pos == N + 1:\n                pos = 1\n            if pos == fixed:\n                blocked = True\n                break\n        if not blocked:\n            return d\n    # If both arcs blocked? Guarantee says achievable, so one must be valid.\n    # Return minimal distance over all valid directions (fallback)\n    best = None\n    for step in (1, -1):\n        d = dist_dir(start, target, N, step)\n        pos = start\n        ok = True\n        for _ in range(d):\n            pos = pos + step\n            if pos == 0:\n                pos = N\n            elif pos == N + 1:\n                pos = 1\n            if pos == fixed:\n                ok = False\n                break\n        if ok:\n            if best is None or d < best:\n                best = d\n    return best\n\ndef solve():\n    data = sys.stdin.read().split()\n    idx = 0\n    N = int(data[idx]); idx += 1\n    Q = int(data[idx]); idx += 1\n    l = 1\n    r = 2\n    total = 0\n    for _ in range(Q):\n        H = data[idx]; T = int(data[idx + 1]); idx += 2\n        if H == 'L':\n            c = move_cost(l, T, r, N)\n            total += c\n            l = T\n        else:\n            c = move_cost(r, T, l, N)\n            total += c\n            r = T\n    print(total)\n\nsolve()",
