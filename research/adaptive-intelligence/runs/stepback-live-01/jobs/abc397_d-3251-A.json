    "code": "import sys\nimport math\n\ndef solve():\n    data = sys.stdin.read().strip()\n    if not data:\n        return\n    N = int(data)\n    for d in range(1, 1000000):\n        if N % d != 0:\n            continue\n        M = N // d\n        # 3y^2 + 3d y + d^2 = M\n        # 3y^2 + 3d y + (d^2 - M) = 0\n        # y = (-3d + sqrt(9d^2 - 12(d^2 - M)))/(6)\n        # = (-3d + sqrt(12M - 3d^2))/6\n        disc = 12 * M - 3 * d * d\n        if disc < 0:\n            continue\n        s = math.isqrt(disc)\n        if s * s != disc:\n            continue\n        num = -3 * d + s\n        if num < 0 or num % 6 != 0:\n            continue\n        y = num // 6\n        if y > 0:\n            x = y + d\n            if x * x * x - y * y * y == N:\n                print(x, y)\n                return\n    print(-1)\n\nsolve()",
