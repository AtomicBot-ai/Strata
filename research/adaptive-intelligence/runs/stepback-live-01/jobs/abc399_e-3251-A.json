  "selected": {
    "code": "import sys\nfrom collections import defaultdict\n\ndef main():\n    data = sys.stdin.read().split()\n    N = int(data[0])\n    S = data[1]\n    T = data[2]\n    need = defaultdict(set)\n    for i in range(N):\n        need[S[i]].add(T[i])\n    for x, vals in need.items():\n        if len(vals) > 1:\n            print(-1)\n            return\n    mapping = {}\n    for x, vals in need.items():\n        y = next(iter(vals))\n        if y != x:\n            mapping[x] = y\n    if not mapping:\n        print(0)\n        return\n    chars = set(mapping) | set(mapping.values())\n    # build graph among involved chars\n    adj = defaultdict(set)\n    for x, y in mapping.items():\n        adj[x].add(y)\n        adj[y].add(x)\n    seen = set()\n    components = 0\n    extra = 0\n    for c in list(chars):\n        if c in seen:\n            continue\n        stack = [c]\n        comp = set()\n        while stack:\n            v = stack.pop()\n            if v in comp:\n                continue\n            comp.add(v)\n            for nb in adj[v]:\n                if nb not in comp:\n                    stack.append(nb)\n        seen |= comp\n        # check cycle vs chain\n        # Each involved char has at most one outgoing edge.\n        # Find node with no outgoing edge (sink) and with no incoming edge (source)\n        out = {v: mapping.get(v) for v in comp}\n        incoming = defaultdict(int)\n        for x, y in mapping.items():\n            if y in comp:\n                incoming[y] += 1\n        sources = [v for v in comp if incoming[v] == 0]\n        sinks = [v for v in comp if mapping.get(v) is None]\n        # if cycle: every node has incoming and outgoing\n        if len(sources) == 0 and len(sinks) == 0 and len(comp) > 1:\n            components += 1\n            extra += 1\n        else:\n            components += 1\n        # cycle: number of operations equals number of nodes? Let's compute directly\n        # Simpler: compute operations via greedy path\n    # Recompute properly:\n    # Each component is either a single node (no edge), chain, or cycle.\n    # For chain: operations = number of nodes in chain? Actually one operation replaces all occurrences of x; a chain x->y->z requires 2 operations.\n    # For cycle x->y->z->x: operations = len(cycle)? Because need to process carefully.\n    # Known formula for this task:\n    # ops = number of components (connected subgraphs with edges) + number of cycles with length>1\n    # Wait cycles require one extra operation? Sample 4: S=abac T=bcba. mapping a->b,b->c,c->b? let's inspect.\n    # Better implement brute over components.\n    seen = set()\n    ops = 0\n    for c in list(chars):\n        if c in seen:\n            continue\n        stack=[c]; comp=set()\n        while stack:\n            v=stack.pop()\n            if v in comp: continue\n            comp.add(v)\n            for nb in adj[v]:\n                if nb not in comp:\n                    stack.append(nb)\n        seen |= comp\n        # Determine if component has edges\n        edges = [(x,y) for x,y in mapping.items() if x in comp and y in comp]\n        if not edges:\n            continue\n        # Build incoming/outgoing\n        outmap = {x:y for x,y in edges}\n        indeg = {v:0 for v in comp}\n        for x,y in edges:\n            indeg[y]+=1\n        # sources = nodes with indeg 0 (not mapped from a node in comp)\n        sources=[v for v in comp if indeg[v]==0]\n        # if cycle: no sources\n        if not sources:\n            # cycle length = number nodes (since each node has exactly one outgoing and one incoming)\n            ops += len(comp) + 1  # ??? too high\n        else:\n            # chain: number of nodes? For chain with edges count n-1, operations = n-1? Sample1 comp? likely 4.\n            ops += len(edges)\n    print(ops)\n\nmain()",
