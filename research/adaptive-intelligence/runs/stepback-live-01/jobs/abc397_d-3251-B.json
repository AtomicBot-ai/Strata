    "code": "import sys\nimport math\n\ndef solve():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    N = int(data[0])\n    # direct search over x,y with pruning by difference\n    # Use x near cube root of N + y^3; simpler: iterate d and y\n    # d = x-y; N = d*(3*y^2 + 3*d*y + d^2)\n    # y = (-3d + sqrt(9d^2 + 12(N/d - d^2)/d))/6 roughly; do integer check instead\n    # Practical: iterate y in range and solve for d approximately\n    # Since N up to 1e18, cube root up to ~1e6, iterate y up to cube root of N + d stuff\n    limit = int(round(N ** (1/3))) + 2\n    found = None\n    # search d up to maybe 1e6? but N large with d small\n    # Enumerate d from 1 up to limit\n    for d in range(1, limit + 2):\n        # N/d must be integer and >= d^2? quadratic in y: 3y^2 + 3d y + (d^2 - N/d)=0\n        if N % d != 0:\n            continue\n        M = N // d\n        # 3y^2 + 3d y + d^2 = M\n        # 3y^2 + 3d y + (d^2 - M)=0\n        a = 3\n        b = 3 * d\n        c = d * d - M\n        disc = b*b - 4*a*c\n        if disc < 0:\n            continue\n        sqrt_disc = math.isqrt(disc)\n        if sqrt_disc * sqrt_disc != disc:\n            continue\n        # y = (-b + sqrt_disc)/(2a)\n        num = -b + sqrt_disc\n        den = 2 * a\n        if num < 0 or num % den != 0:\n            continue\n        y = num // den\n        if y <= 0:\n            continue\n        x = y + d\n        if x*x*x - y*y*y == N:\n            found = (x, y)\n            break\n    if found:\n        print(found[0], found[1])\n    else:\n        print(-1)\n\nsolve()",
