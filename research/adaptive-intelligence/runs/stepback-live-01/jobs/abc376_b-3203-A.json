    "code": "import sys\n\ndef solve():\n    data = sys.stdin.read().split()\n    idx = 0\n    N = int(data[idx]); idx += 1\n    Q = int(data[idx]); idx += 1\n\n    l = 1\n    r = 2\n\n    total = 0\n\n    def arc_dist(src, dst, blocked):\n        # distance along direction d (1 = clockwise i->i+1 mod N) from src to dst\n        # path consists of parts src+1,...,dst; if blocked is on path or dst? dst != blocked.\n        # blocked should not appear among src+1..dst\n        d = (dst - src) % N\n        path = set()\n        x = src\n        for _ in range(d):\n            x = (x % N) + 1\n            path.add(x)\n        if blocked in path:\n            return None\n        return d\n\n    for _ in range(Q):\n        H = data[idx]; T = int(data[idx+1]); idx += 2\n        if H == 'L':\n            moving = l\n            fixed = r\n        else:\n            moving = r\n            fixed = l\n\n        # reachable direction is the one whose path avoids fixed hand.\n        cw = arc_dist(moving, T, fixed)\n        ccw = arc_dist(moving, T, fixed)  # same formula? Need counterclockwise distance\n        # counterclockwise distance is (moving - dst) mod N\n        d = (moving - T) % N\n        path = set()\n        x = moving\n        for _ in range(d):\n            x = x - 1 if x > 1 else N\n            path.add(x)\n        ccw = None if fixed in path else d\n\n        candidates = []\n        if cw is not None:\n            candidates.append(cw)\n        if ccw is not None:\n            candidates.append(ccw)\n        # exactly one/both reachable; choose min\n        d = min(candidates)\n        total += d\n        if H == 'L':\n            l = T\n        else:\n            r = T\n\n    print(total)\n\nsolve()",
