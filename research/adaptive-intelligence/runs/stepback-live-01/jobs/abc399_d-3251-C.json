      "code": "import sys\n\ndef solve():\n    data = sys.stdin.read().split()\n    it = iter(data)\n    T = int(next(it))\n    out = []\n    for _ in range(T):\n        N = int(next(it))\n        A = [int(next(it)) for _ in range(2*N)]\n        pos = {i: [] for i in range(1, N+1)}\n        for idx, v in enumerate(A):\n            pos[v].append(idx)\n        ans = 0\n        for a in range(1, N+1):\n            pa = pos[a]\n            if abs(pa[0]-pa[1]) == 1:\n                continue\n            for b in range(a+1, N+1):\n                pb = pos[b]\n                if abs(pb[0]-pb[1]) == 1:\n                    continue\n                # four swaps\n                ok = False\n                for i in pa:\n                    for j in pb:\n                        # new positions of a after swap\n                        pa_new = [i if x == j else x for x in pa]  # wait wrong, need actual positions\n                        # better: track positions\n                        # swap A_i and A_j: a-occurrence at i moves to j, b-occurrence at j moves to i\n                        new_pa = []\n                        for x in pa:\n                            if x == i:\n                                new_pa.append(j)\n                            elif x == j:\n                                new_pa.append(i)\n                            else:\n                                new_pa.append(x)\n                        new_pb = []\n                        for x in pb:\n                            if x == i:\n                                new_pb.append(j)\n                            elif x == j:\n                                new_pb.append(i)\n                            else:\n                                new_pb.append(x)\n                        # Since i is an a-position and j is a b-position, swap affects only those positions\n                        new_pa = [j if x == i else x for x in pa]\n                        new_pb = [i if x == j else x for x in pb]\n                        if abs(new_pa[0]-new_pa[1]) == 1 and abs(new_pb[0]-new_pb[1]) == 1:\n                            ok = True\n                            break\n                    if ok:\n                        break\n                if ok:\n                    ans += 1\n        out.append(str(ans))\n    sys.stdout.write(\"\\n\".join(out))\n\nsolve()"
