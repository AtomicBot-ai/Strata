      "code": "import sys\nfrom collections import deque\n\ndef solve():\n    input = sys.stdin.readline\n    N, M = map(int, input().split())\n    adj = [[] for _ in range(N + 1)]\n    edges = []\n    for _ in range(M):\n        u, v = map(int, input().split())\n        edges.append((u, v))\n        adj[u].append(v)\n        adj[v].append(u)\n\n    color = [0] * (N + 1)  # 0 unvisited, 1/2\n    total_candidates = 0\n    seen = [False] * (N + 1)\n\n    # Existing edges set for quick check\n    edge_set = set()\n    for u, v in edges:\n        edge_set.add((min(u, v), max(u, v)))\n\n    for start in range(1, N + 1):\n        if seen[start]:\n            continue\n        # BFS component\n        color[start] = 1\n        seen[start] = True\n        q = deque([start])\n        comp_vertices = [start]\n        a = 1  # side 1 count\n        b = 0\n        while q:\n            x = q.popleft()\n            for y in adj[x]:\n                if not seen[y]:\n                    seen[y] = True\n                    color[y] = 3 - color[x]  # 1->2, 2->1\n                    q.append(y)\n                    comp_vertices.append(y)\n                    if color[y] == 1:\n                        a += 1\n                    else:\n                        b += 1\n        # count existing edges within component\n        existing_cross = 0\n        for u, v in edges:\n            if color[u] and color[v] and color[u] != color[v]:\n                # but we must ensure same component; color 0 means not visited; but if same component yes\n                existing_cross += 1\n        # Wait: this counts all cross-side existing edges across all components in each iteration.\n        # Recompute per component properly\n        existing_cross_comp = 0\n        comp_set = set(comp_vertices)\n        for u, v in edges:\n            if u in comp_set and v in comp_set:\n                if color[u] != color[v]:\n                    existing_cross_comp += 1\n        candidates = a * b - existing_cross_comp\n        total_candidates += candidates\n\n    if total_candidates % 2 == 1:\n        print(\"Aoki\")\n    else:\n        print(\"Takahashi\")\n\nsolve()"
