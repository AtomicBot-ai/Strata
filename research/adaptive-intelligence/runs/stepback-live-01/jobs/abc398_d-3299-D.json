    "code": "import sys\n\ndef main():\n    data = sys.stdin.read().split()\n    N = int(data[0])\n    R = int(data[1])\n    C = int(data[2])\n    S = data[3]\n    smoke = {(0, 0)}\n    ans = []\n    for i in range(N):\n        ch = S[i]\n        moved = set()\n        for r, c in smoke:\n            if ch == 'N':\n                moved.add((r - 1, c))\n            elif ch == 'W':\n                moved.add((r, c - 1))\n            elif ch == 'S':\n                moved.add((r + 1, c))\n            elif ch == 'E':\n                moved.add((r, c + 1))\n        smoke = moved\n        if (0, 0) not in smoke:\n            smoke.add((0, 0))\n        ans.append('1' if (R, C) in smoke else '0')\n    sys.stdout.write(''.join(ans))\n\nif __name__ == '__main__':\n    main()",
