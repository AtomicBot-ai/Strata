    "code": "import sys\n\ndef main():\n    data = list(map(int, sys.stdin.read().split()))\n    if not data:\n        return\n    idx = 0\n    n = data[idx]; m = data[idx + 1]; idx += 2\n    adj = {i: [] for i in range(1, n + 1)}\n    for _ in range(m):\n        u = data[idx]; v = data[idx + 1]; w = data[idx + 2]; idx += 3\n        adj[u].append((v, w))\n        adj[v].append((u, w))\n\n    best = None\n\n    def dfs(u, x, visited):\n        nonlocal best\n        if u == n:\n            if best is None or x < best:\n                best = x\n            return\n        for v, w in adj[u]:\n            if v not in visited:\n                dfs(v, x ^ w, visited | {v})\n\n    dfs(1, 0, {1})\n    print(best)\n\nif __name__ == \"__main__\":\n    main()",
