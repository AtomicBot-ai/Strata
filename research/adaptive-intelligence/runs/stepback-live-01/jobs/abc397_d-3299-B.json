{
  "task": "abc397_d",
  "seed": 3299,
  "mode": "B",
  "selected": {
    "code": "import sys\n\ndef icbrt(n):\n    if n <= 0:\n        return 0\n    # Use integer Newton/binary search\n    lo, hi = 1, 2_000_000\n    # hi enough for N<=1e18: x^3 approx N so x ~1e6\n    while hi * hi * hi < n:\n        hi *= 2\n    lo, hi = 0, hi\n    while lo < hi:\n        mid = (lo + hi + 1) // 2\n        if mid * mid * mid <= n:\n            lo = mid\n        else:\n            hi = mid - 1\n    return lo\n\ndef solve():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        print(-1)\n        return\n    N = int(data[0])\n    max_x = 2_000_000\n    for x in range(1, max_x + 1):\n        t = x * x * x - N\n        if t <= 0:\n            continue\n        y = icbrt(t)\n        if y >= 1 and y * y * y == t:\n            # check x > y\n            if x > y:\n                print(x, y)\n                return\n    print(-1)\n\nsolve()",
