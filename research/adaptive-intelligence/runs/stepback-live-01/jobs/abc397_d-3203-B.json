  "selected": {
    "code": "import sys\n\ndef main():\n    data = sys.stdin.read().strip().split()\n    if not data:\n        return\n    N = int(data[0])\n    # upper bound for x: x^3 = N + y^3, y>=1, so x <= ceil((N+1)^(1/3)) roughly\n    # but y can be close to x; direct search x in [1, floor(cbrt(N))+2]\n    def icbrt(v):\n        if v <= 0:\n            return 0\n        # integer cube root\n        r = int(v ** (1.0/3.0))\n        while (r+1)**3 <= v:\n            r += 1\n        while r**3 > v:\n            r -= 1\n        return r\n\n    limit = icbrt(N + 1) + 2\n    # More precise: y <= x, x^3 - y^3 = N. We search x from icbrt(N) to icbrt(N)+... \n    # Easier: search y small? x = y + d. Use x range from icbrt(N) to icbrt(N + y^3).\n    # Since y can be large, x can be larger. Use x up to icbrt(2*N) maybe.\n    xmax = icbrt(2*N + 1) + 5\n    for x in range(1, xmax+1):\n        rem = x*x*x - N\n        if rem < 1:\n            continue\n        y = icbrt(rem)\n        # y must be positive and (y+1)^3 > rem\n        for yy in (y, y+1):\n            if yy >= 1 and x*x*x - yy*yy*yy == N:\n                print(x, yy)\n                return\n    print(-1)\n\nif __name__ == \"__main__\":\n    main()",
