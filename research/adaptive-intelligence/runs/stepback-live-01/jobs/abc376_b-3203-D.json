  "selected": {
    "code": "import sys\n\ndef main():\n    data = sys.stdin.read().split()\n    if not data:\n        return\n    idx = 0\n    N = int(data[idx]); idx += 1\n    Q = int(data[idx]); idx += 1\n    l, r = 1, 2\n    total = 0\n    for _ in range(Q):\n        H = data[idx]; T = int(data[idx+1]); idx += 2\n        fixed = r if H == 'L' else l\n        start = l if H == 'L' else r\n        best = None\n        # forward (clockwise) and backward (counterclockwise) paths\n        for dir in (1, -1):\n            pos = start\n            steps = 0\n            ok = True\n            # try until we reach T or a full ring; avoid fixed\n            for _ in range(N):\n                if pos == T:\n                    if best is None or steps < best:\n                        best = steps\n                    break\n                nxt = ((pos - 1 + dir) % N) + 1\n                if nxt == fixed:\n                    ok = False\n                    break\n                pos = nxt\n                steps += 1\n            if ok and pos == T:\n                if best is None or steps < best:\n                    best = steps\n            # also handle reaching T by full cycle? Actually covered.\n        # If best is None (shouldn't happen), fall back to 0\n        if best is None:\n            best = 0\n        total += best\n        if H == 'L':\n            l = T\n        else:\n            r = T\n    print(total)\n\nif __name__ == \"__main__\":\n    main()",
