  "selected": {
    "code": "import sys\n\ndef main():\n    data = sys.stdin.read().split()\n    n = int(data[0])\n    a = list(map(int, data[1:1 + n]))\n\n    # prefix distinct count: pref[i] = distinct in a[0:i]\n    pref = [0] * (n + 1)\n    seen = set()\n    cnt = 0\n    for i in range(n):\n        v = a[i]\n        if v not in seen:\n            seen.add(v)\n            cnt += 1\n        pref[i + 1] = cnt\n\n    # suffix distinct count: suff[i] = distinct in a[i:] (0-index i)\n    suff = [0] * (n + 1)\n    seen = set()\n    cnt = 0\n    for i in range(n - 1, -1, -1):\n        v = a[i]\n        if v not in seen:\n            seen.add(v)\n            cnt += 1\n        suff[i] = cnt\n\n    ans = 0\n    # For each i (1..n-1), find best j in (i+1..n-1)\n    # middle = a[i:j] (0-index), left = a[0:i], right = a[j:n]\n    for i in range(1, n):  # 1-index split i, 0-index left length i\n        left = pref[i]\n        mid = set()\n        mid_cnt = 0\n        # j from i+1 to n-1 (1-index), right length n-j\n        for j in range(i + 1, n):  # 1-index j, 0-index right starts at j\n            v = a[j - 1]  # middle element a[i-1 ... j-1]? careful\n            # Let's define middle elements are a[i:j] in 0-index (0-index positions i..j-1)\n            # Since i is 1-index split, left length = i, so 0-index left is a[0:i].\n            # middle 0-index is a[i:j], right 0-index is a[j:n].\n            # We need to iterate j 0-index = i+1..n-1? Let's instead loop over 0-index middle directly.\n            pass\n        # Simpler: iterate 0-index splits\n        pass\n\n    # Cleaner implementation: iterate 0-index split i0 = left length, j0 = right start\n    # left = a[0:i0], middle = a[i0:j0], right = a[j0:n], with 1 <= i0 < j0 <= n-1\n    ans = 0\n    # Precompute prefix distinct\n    for i0 in range(1, n):\n        left = pref[i0]\n        mid = set()\n        mid_cnt = 0\n        for j0 in range(i0 + 1, n):\n            v = a[j0 - 1]  # not correct; need add element at position j0-1? middle is a[i0:j0], last element index j0-1\n            # Add a[j0-1] only when expanding j0 by 1: middle = a[i0:j0]\n            if v not in mid:\n                mid.add(v)\n                mid_cnt += 1\n            right = suff[j0]\n            cur = left + mid_cnt + right\n            if cur > ans:\n                ans = cur\n    print(ans)\n\nmain()",
