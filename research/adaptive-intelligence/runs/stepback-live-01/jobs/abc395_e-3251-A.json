  "selected": {
    "code": "import heapq\n\ndef main():\n    import sys\n    data = sys.stdin.read().split()\n    it = iter(data)\n    n = int(next(it)); m = int(next(it)); x = int(next(it))\n    edges = []\n    for _ in range(m):\n        u = int(next(it)); v = int(next(it))\n        edges.append((u, v))\n\n    INF = None\n    dist = [[None] * 2 for _ in range(n + 1)]\n    dist[1][0] = 0\n    pq = [(0, 1, 0)]\n\n    while pq:\n        d, v, p = heapq.heappop(pq)\n        if dist[v][p] is not None and d > dist[v][p]:\n            continue\n        # move\n        for u, w in edges:\n            if p == 0:\n                # direction unchanged: u->w\n                if u == v:\n                    to = w\n                elif w == v:\n                    continue\n                else:\n                    continue\n            else:\n                # direction reversed: w->u\n                if w == v:\n                    to = u\n                elif u == v:\n                    continue\n                else:\n                    continue\n            nd = d + 1\n            if dist[to][p] is None or nd < dist[to][p]:\n                dist[to][p] = nd\n                heapq.heappush(pq, (nd, to, p))\n        # flip\n        nd = d + x\n        if dist[v][p ^ 1] is None or nd < dist[v][p ^ 1]:\n            dist[v][p ^ 1] = nd\n            heapq.heappush(pq, (nd, v, p ^ 1))\n\n    ans = min(dist[n][0] if dist[n][0] is not None else float('inf'),\n              dist[n][1] if dist[n][1] is not None else float('inf'))\n    print(ans)\n\nif __name__ == \"__main__\":\n    main()",
