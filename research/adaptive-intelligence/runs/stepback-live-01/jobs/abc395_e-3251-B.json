{
  "task": "abc395_e",
  "seed": 3251,
  "mode": "B",
  "selected": {
    "code": "import sys\nimport heapq\n\ndef main():\n    input = sys.stdin.readline\n    N, M, X = map(int, input().split())\n    edges = []\n    for _ in range(M):\n        u, v = map(int, input().split())\n        edges.append((u, v))\n\n    # state id: (vertex, reversed?) where reversed 0=normal, 1=reversed\n    # normal edges: u->v; reversed edges: v->u\n    # Costs are nonnegative; X>0.\n    INF = float('inf')\n    dist = [[INF, INF] for _ in range(N + 1)]\n    dist[1][0] = 0\n    pq = [(0, 1, 0)]\n\n    def rev_state(u, v, s):\n        # If s==0, directed edge u->v. If s==1, edge v->u.\n        if s == 0:\n            return (u, v)\n        else:\n            return (v, u)\n\n    while pq:\n        d, v, s = heapq.heappop(pq)\n        if d > dist[v][s]:\n            continue\n        # Reversal operation\n        ns = 1 - s\n        nd = d + X\n        if nd < dist[v][ns]:\n            dist[v][ns] = nd\n            heapq.heappush(pq, (nd, v, ns))\n        # Move operation\n        for u, v_ in edges:\n            if s == 0:\n                if u == v:\n                    to = v_\n                else:\n                    continue\n            else:\n                # reversed edge: u->v becomes v->u, so from v_ to u\n                if v_ == v:\n                    to = u\n                else:\n                    continue\n            nd = d + 1\n            if nd < dist[to][s]:\n                dist[to][s] = nd\n                heapq.heappush(pq, (nd, to, s))\n\n    ans = min(dist[N][0], dist[N][1])\n    print(ans)\n\nmain()",
    "delivered_ms": 20444.26887499867,
