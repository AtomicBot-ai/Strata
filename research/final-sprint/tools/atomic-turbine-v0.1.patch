+++ b/atomic/THIRD_PARTY.md
@@ -0,0 +1,10 @@
+# Компоненты локальной сборки
+
+Atomic Turbine основан на Strata 0.1.69, commit `b28ca95e3e6847f2d5e317994f253b66716deeaa`. Авторские уведомления и исходная лицензия MIT сохранены в LICENSE. История Git доступна в исходном форке.
+
+- В Inkling встроен декодер Zstandard (BSD) и используются заголовки stb (выбрана лицензия MIT). Тексты находятся в каталоге licenses.
+- Код квантования и форматы данных включают производные от ggml (MIT). Лицензии vendored ggml и заголовков прилагаются. Qwen собран со штатным CPU-кодом Strata, отдельная динамическая библиотека ggml не требуется.
+- Слой Metal использует заголовки Apple metal-cpp (Apache License 2.0). Текст прилагается в licenses. Системные фреймворки предоставляет macOS.
+- Веб-интерфейс Strata содержит KaTeX (MIT). Уведомление остаётся в terminal/serve/web/vendor/katex. Сведения Strata о происхождении дополнительного DFlash2 находятся в terminal/data/dflash2-tuned.
+- Шрифт Outfit поставляется с SIL Open Font License 1.1 в terminal/serve/web/fonts/OFL.txt.
+- Веса целевых моделей, их токенизаторы и OpenCode устанавливаются отдельно. Python-пакеты API и их версии перечислены в terminal/requirements.txt и распространяются их авторами.
diff --git a/atomic/atomic-turbine b/atomic/atomic-turbine
new file mode 100755
index 00000000..1e9f4f1b
--- /dev/null
+++ b/atomic/atomic-turbine
@@ -0,0 +1,50 @@
+#!/usr/bin/env python3
+"""Atomic Turbine 0.1 local Metal engines and Strata-compatible HTTP gateway."""
+import argparse
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+
+ROOT=Path(__file__).resolve().parent
+BIN=ROOT/"bin"
+
+
+def main():
+    if len(sys.argv)<2 or sys.argv[1] in ("-h","--help"):
+        print("Atomic Turbine 0.1 (macOS arm64)\n  inkling [native Inkling flags]\n  qwen [native Qwen flags]\n  api [Strata HTTP server flags]\n  serve-inkling --model FILE --tokenizer DIR [--port 8080] [--context 24576]\n  --version")
+        return
+    mode,*args=sys.argv[1:]
+    if mode=="--version":
+        print("Atomic Turbine 0.1.0");return
+    if mode in ("inkling","qwen"):
+        exe=BIN/("strata-inkling" if mode=="inkling" else "strata")
+        os.execv(str(exe),[str(exe),*args])
+    server=ROOT/"terminal/serve/server.py"
+    if mode=="api":
+        os.execv(sys.executable,[sys.executable,str(server),*args])
+    if mode!="serve-inkling":
+        raise SystemExit("unknown subcommand: "+mode)
+    p=argparse.ArgumentParser(prog="atomic-turbine serve-inkling")
+    p.add_argument("--model",type=Path,required=True)
+    p.add_argument("--tokenizer",type=Path,required=True)
+    p.add_argument("--port",type=int,default=8080)
+    p.add_argument("--context",type=int,default=24576)
+    a=p.parse_args(args)
+    if not a.model.is_file() or not (a.tokenizer/"merges.txt").is_file():
+        p.error("provide a readable .strata model and converted tokenizer directory")
+    cfg=dict(exe=str(BIN/"strata-inkling"),arch="inkling2_loop",tokenizer=str(a.tokenizer.resolve()),model_name="inkling",
+             args=["--serve","--native",str(a.model.resolve()),"--draft","off","--kv","fp16","--max-context",str(a.context),
+                   "--parallel","2","--chunk","128"],host="127.0.0.1",port=a.port,open_browser=False)
+    with tempfile.TemporaryDirectory(prefix="atomic-turbine-") as d:
+        path=Path(d)/"config.json";path.write_text(json.dumps(cfg))
+        proc=subprocess.Popen([sys.executable,str(server),"--engine","strata","--config",str(path),"--host","127.0.0.1",
+                               "--port",str(a.port),"--parallel","2","--offline","--no-api-key"])
+        try:
+            raise SystemExit(proc.wait())
+        except KeyboardInterrupt:
+            proc.terminate()
+            proc.wait()
+if __name__=="__main__":main()
diff --git a/atomic/package.py b/atomic/package.py
new file mode 100644
index 00000000..4e2db7cb
--- /dev/null
+++ b/atomic/package.py
@@ -0,0 +1,88 @@
+"""Assemble a macOS arm64 ZIP from the two compiled engines and their runtime files."""
+import argparse
+import hashlib
+import json
+import os
+import shutil
+import subprocess
+import tempfile
+import zipfile
+from pathlib import Path
+
+REPO = Path(__file__).resolve().parents[1]
+
+
+def copy(source, destination):
+    destination.parent.mkdir(parents=True, exist_ok=True)
+    shutil.copy2(source, destination)
+
+
+def assemble(folder, args):
+    copy(args.inkling, folder / "bin/strata-inkling")
+    copy(args.qwen, folder / "bin/strata")
+    for name in ("atomic-turbine", "README.md", "THIRD_PARTY.md"):
+        copy(REPO / "atomic" / name, folder / name)
+    copy(REPO / "LICENSE", folder / "LICENSE")
+
+    vendor = REPO / "engine/third_party"
+    licenses = {
+        "zstd-BSD": vendor / "zstd-dec/LICENSE",
+        "ggml-MIT": vendor / "strata-ggml/LICENSE",
+        "ggml-headers-MIT": vendor / "ggml/LICENSE",
+        "stb": vendor / "stb/LICENSE",
+        "metal-cpp-Apache-2.0": args.metal_cpp / "LICENSE.txt",
+    }
+    for name, source in licenses.items():
+        copy(source, folder / "licenses" / f"{name}.txt")
+
+    metal = folder / "bin/metal"
+    shutil.copytree(REPO / "engine/metal/kernels", metal / "kernels")
+    shutil.copytree(REPO / "engine/metal/src/engine/msl", metal / "engine-msl")
+    copy(REPO / "engine/include/strata/quant/strata-quant-common.h", metal / "strata-quant-common.h")
+    for name in ("draft_vocab.bin", "expert-profile.bin"):
+        copy(REPO / "terminal/data" / name, metal / "data" / name)
+
+    exclude = shutil.ignore_patterns("__pycache__", "*.pyc", "test_*.py", "tests", "experimental-speed-projection")
+    for name in ("serve", "tools", "strata_control", "strata_cli", "data"):
+        shutil.copytree(REPO / "terminal" / name, folder / "terminal" / name, ignore=exclude)
+    for name in ("requirements.txt", "strata.py"):
+        copy(REPO / "terminal" / name, folder / "terminal" / name)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("inkling", type=Path)
+    parser.add_argument("qwen", type=Path)
+    parser.add_argument("metal_cpp", type=Path)
+    parser.add_argument("--output", type=Path, default=Path("dist"))
+    args = parser.parse_args()
+
+    commit = subprocess.check_output(["git", "-C", str(REPO), "rev-parse", "HEAD"], text=True).strip()
+    args.output.mkdir(parents=True, exist_ok=True)
+    with tempfile.TemporaryDirectory(dir=args.output) as temp:
+        staging = Path(temp)
+        folder = staging / f"Atomic-Turbine-0.1.0-{commit[:8]}"
+        assemble(folder, args)
+        hashes = {
+            str(path.relative_to(folder)): hashlib.sha256(path.read_bytes()).hexdigest()
+            for path in sorted(folder.rglob("*")) if path.is_file()
+        }
+        manifest = dict(version="0.1.0", platform="macOS arm64", fork_commit=commit,
+                        upstream="b28ca95e3e6847f2d5e317994f253b66716deeaa", files=hashes)
+        (folder / "manifest.json").write_text(json.dumps(manifest, indent=2) + "\n")
+        archive = staging / (folder.name + ".zip")
+        with zipfile.ZipFile(archive, "w", compression=zipfile.ZIP_DEFLATED, compresslevel=4) as handle:
+            for path in sorted(folder.rglob("*")):
+                if path.is_file():
+                    handle.write(path, arcname=path.relative_to(staging))
+        with zipfile.ZipFile(archive) as handle:
+            bad_member = handle.testzip()
+            if bad_member:
+                raise ValueError(f"ZIP checksum failed for {bad_member}")
+        destination = args.output / archive.name
+        os.replace(archive, destination)
+    print(destination.resolve())
+
+
+if __name__ == "__main__":
+    main()
