#!/usr/bin/env python3
"""Transparent native transport observer for the local OpenCode smoke test."""
import json
import os
import signal
import subprocess
import sys
import threading
import time
from pathlib import Path

here=Path(__file__).resolve()
base=here.parents[3]
cfg=json.loads((base/".work/final-sprint/s04-wire-config.json").read_text())
with open(cfg["events"],"a",buffering=1) as log:
    lock=threading.Lock()
    with subprocess.Popen([cfg["binary"],*sys.argv[1:]],stdin=subprocess.PIPE,stdout=subprocess.PIPE,
                          env=dict(os.environ,STRATA_SCALING_LAB="1")) as child:
        def forward_stop(*_):
            child.terminate()
        signal.signal(signal.SIGTERM,forward_stop)
        def relay(src,dst,direction):
            for line in src:
                words=line.split(None,3)
                if words:
                    tag=words[0].decode(errors="replace")
                    if tag in {"GEN","GENERATE","BGEN","LABSAVE","LABRESTORE","SAVED","RESTORED","RESUME","REUSED","CANCEL","BSTOP","BDONE","DONE","BADM","INFO","READY","QUIT"}:
                        # Capture counts and slot IDs; exclude prompt text and token arrays.
                        detail=[]
                        for field in words[1:3]:
                            if len(field)<=16 and field.isdigit():detail.append(int(field))
                            else:break
                        with lock: log.write(json.dumps([time.monotonic_ns(),child.pid,direction,tag,detail])+"\n")
                try:
                    dst.write(line);dst.flush()
                except BrokenPipeError:return
        t=threading.Thread(target=relay,args=(sys.stdin.buffer,child.stdin,"in"),daemon=True)
        t.start()
        relay(child.stdout,sys.stdout.buffer,"out")
        sys.exit(child.wait())
